{
  "name": "advbox-dashboard",
  "version": "1.1.0",
  "description": "Dashboard personalizado para AdvBox — Eduardo Rodrigues Advocacia",
  "main": "clients/dashboard/index.js",
  "scripts": {
    "start": "node clients/dashboard/index.js",
    "dev": "NODE_ENV=development node clients/dashboard/index.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json,md}\"",
    "test": "node --test --test-reporter=spec",
    "test:unit": "node --test --test-reporter=spec tests/unit/access-log-buffer.test.js tests/unit/advbox-pagination.test.js tests/unit/circuit-breaker.test.js tests/unit/cron-guard.test.js tests/unit/validate.test.js",
    "test:integration": "node --test --test-reporter=spec tests/integration/auth.test.js",
    "push-github": "bash scripts/push-github.sh"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.0",
    "bcryptjs": "^3.0.3",
    "cookie-session": "^2.1.1",
    "express": "^4.22.1",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^2.7.0",
    "nodemailer": "^8.0.7",
    "pg": "^8.20.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "eslint": "^9.15.0",
    "prettier": "^3.4.2"
  }
}
