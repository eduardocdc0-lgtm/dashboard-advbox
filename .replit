modules = ["nodejs-20", "postgresql-16", "python-3.11"]
[nix]
channel = "stable-25_05"

[agent]
expertMode = true
integrations = ["github:1.0.0"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node index.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

# ── IMPORTANTE ──────────────────────────────────────────────────────────────
# NUNCA adicionar seção [userenv.shared] aqui — este arquivo vai pro Git.
# Variáveis de ambiente (CHATGURU_API_KEY, READ_API_KEY, ADMIN_USER, etc) ficam
# em Replit Secrets (Tools → Secrets). Boot lê via process.env normalmente.
#
# Histórico: este arquivo já teve tokens commitados — todos rotacionados em
# 2026-05-16 após audit de segurança. Histórico mantido para referência.
# ────────────────────────────────────────────────────────────────────────────

[deployment]
deploymentTarget = "autoscale"
run = ["node", "index.js"]
