# ──────────────────────────────────────────────────────────────────────────────
# Dashboard AdvBox — Variáveis de ambiente
# Copie este arquivo para `.env` (no Replit: vá em Secrets) e preencha.
# ──────────────────────────────────────────────────────────────────────────────

# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=5000

# ── Sessão (OBRIGATÓRIO) ──────────────────────────────────────────────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
SESSION_MAX_AGE_MS=43200000

# ── Login / autenticação ─────────────────────────────────────────────────────
# AUTH_REQUIRE_BCRYPT:
#   true  → só *_HASH funciona. Plaintext (*_PASS, ADV_USER_<NOME>) é IGNORADO
#           e o boot FALHA se setado sem o hash correspondente. Default em prod.
#   false → plaintext aceito (só pra rodar local sem precisar gerar hash).
#           Default em dev. FATAL em prod — nunca deploye com false.
# Default: true se NODE_ENV=production, false caso contrário.
AUTH_REQUIRE_BCRYPT=
#
# Gerar hash: node scripts/hash-password.js  (prompt interativo).
# Cole o resultado em *_PASS_HASH (este arquivo ou Replit > Secrets).
# Depois de confirmar login OK, REMOVA *_PASS pra não deixar plaintext circulando.
ADMIN_USER=eduardo
ADMIN_PASS_HASH=
ADMIN_PASS=
TEAM_USER=time
TEAM_PASS_HASH=
TEAM_PASS=

# ── API Key (acesso somente-leitura admin via header X-Api-Key) ───────────────
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
READ_API_KEY=

# ── CORS — domínios permitidos (separados por vírgula, sem espaço) ────────────
# Em prod, liste APENAS os domínios reais (Replit, etc):
CORS_ORIGINS=https://seu-dashboard.repl.co,https://seu-dominio.com.br

# ── AdvBox API ────────────────────────────────────────────────────────────────
ADVBOX_TOKEN=
ADVBOX_BASE_URL=https://app.advbox.com.br/api/v1
# Token do webhook Flowter (AdvBox → dashboard, eventos em tempo real).
# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Configurar no AdvBox > Flowter com o mesmo valor + URL apontando pra
# /api/advbox/webhook/flowter (ver clients/dashboard/routes/advbox-webhook.js).
ADVBOX_FLOWTER_TOKEN=
# Caps de paginação — getAll* para de buscar após N páginas. Defaults dão
# cobertura pra ~15k lawsuits / 20k transactions / 20k customers. Se o
# escritório passar disso, o boot emite WARN e /api/cache-status.pagination
# contabiliza eventos — aumentar a env aqui (ex: 60 = 30k lawsuits).
ADVBOX_MAX_PAGES_LAWSUITS=30
ADVBOX_MAX_PAGES_TRANSACTIONS=20
ADVBOX_MAX_PAGES_CUSTOMERS=20

# ── Meta Ads (opcional) ───────────────────────────────────────────────────────
META_TOKEN=
META_AD_ACCOUNT=act_654132083965752
META_API_VERSION=v19.0

# ── ChatGuru (WhatsApp) ───────────────────────────────────────────────────────
CHATGURU_BASE_URL=https://s22.chatguru.app/api/v1
CHATGURU_ACCOUNT_ID=
CHATGURU_PHONE_ID=
CHATGURU_API_KEY=
CHATGURU_WEBHOOK_SECRET=

# ── ASAAS (gateway de pagamento) ──────────────────────────────────────────────
# Token da conta ASAAS (sandbox = contém "_hmlg_", produção = sem). Sem token
# o cliente vira null e os endpoints /api/asaas/* retornam 503.
ASAAS_TOKEN=
# Token do webhook ASAAS (proteção do POST /api/asaas/webhook). OBRIGATÓRIO.
# Sem ele o webhook recusa TUDO (anti-falsificação). Gerar com mesmo crypto
# random + configurar no painel ASAAS > Webhooks > Token (idem).
ASAAS_WEBHOOK_TOKEN=
# URL pública do app — usada pro auto-register do webhook ASAAS na conta.
# Em prod: a URL do Replit. Localhost é pulado (ASAAS não bate em localhost).
APP_PUBLIC_URL=https://seu-dashboard.repl.co

# ── Discord (briefing diário + alertas de cron) ───────────────────────────────
# Webhook URL — Painel do Discord > Server Settings > Integrations > Webhooks.
# Usado por: (a) briefing diário 7h30 seg-sex; (b) alertas quando crons falham
# 2x consecutivas. Sem ele, briefing não roda e alertas viram no-op (errors
# ainda saem no log).
DISCORD_WEBHOOK_URL=
# Override do cron de briefing (default '30 7 * * 1-5' = 7h30 seg-sex)
BRIEFING_CRON=
# Desliga o briefing inteiro sem mexer no resto
BRIEFING_ENABLED=true

# ── Banco (PostgreSQL) ────────────────────────────────────────────────────────
DATABASE_URL=
# Recomendado: 15 em produção. Em containers muito pequenos pode usar 10.
# Abaixo de 10 o boot emite WARN — auto-workflow + crons + requests dão timeout.
DB_POOL_MAX=15

# ── Limites e rate-limits ─────────────────────────────────────────────────────
LIMIT_BODY_JSON=1mb
LIMIT_UPLOAD_BYTES=15728640
RATE_LOGIN_MAX=5
RATE_LOGIN_WINDOW_MS=900000
RATE_API_MAX=600
RATE_API_WINDOW_MS=60000
